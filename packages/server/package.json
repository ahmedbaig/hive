{
  "name": "@hive/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc --build && node -e \"require('node:fs').cpSync('src/migrations','dist/migrations',{recursive:true})\"",
    "dev": "tsc --build --watch --preserveWatchOutput & node --watch dist/index.js",
    "start": "node dist/index.js",
    "migrate": "node dist/migrate.js"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.0.1",
    "@hive/shared": "*",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.2",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "prom-client": "^15.1.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13"
  }
}
