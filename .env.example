# ── Hive server ────────────────────────────────────────────────────────────
# Bind 0.0.0.0 so other machines on the LAN can reach this WSL host.
HIVE_HOST=0.0.0.0
HIVE_PORT=7777

# Public base URL agents and browsers use to reach the server. Set this to the
# LAN address of the machine running hive-server, not localhost — agents on
# other PCs resolve it verbatim.
HIVE_PUBLIC_URL=http://192.168.0.117:7777

# ── Redis ──────────────────────────────────────────────────────────────────
# NOTE: db 0 on this Redis instance is in active use by an unrelated
# Django/Celery stack (kombu queues, TMDB/Trakt caches). Hive lives on its own
# database index and prefixes every key with `hive:`. Never run FLUSHALL here.
REDIS_HOST=192.168.0.117
REDIS_PORT=6379
REDIS_DB=3
REDIS_PASSWORD=

# ── Postgres ───────────────────────────────────────────────────────────────
PGHOST=192.168.0.117
PGPORT=5432
PGDATABASE=hive
PGUSER=hive
PGPASSWORD=

# Superuser connection used only by `npm run migrate -- --create` to create the
# hive role and database on first run. Leave blank afterwards.
PG_ADMIN_USER=postgres
PG_ADMIN_PASSWORD=
PG_ADMIN_DATABASE=postgres

# ── Auth ───────────────────────────────────────────────────────────────────
# Empty token = open LAN mode: any host on the private network can register an
# agent and approve tool calls. Set a value to require `Authorization: Bearer`
# on every REST call, WebSocket upgrade, and agent registration.
HIVE_TOKEN=

# ── Permission gate ────────────────────────────────────────────────────────
# How long a PreToolUse hook waits for a remote decision before falling back to
# the local terminal prompt. Keep below the Claude Code hook timeout (60s).
HIVE_PERMISSION_TIMEOUT_MS=45000

# Tool patterns auto-approved without hitting the queue, comma separated.
HIVE_AUTO_ALLOW=Read,Glob,Grep,TodoWrite,NotebookRead

# ── Agent daemon ───────────────────────────────────────────────────────────
HIVE_AGENT_NAME=
HIVE_HEARTBEAT_MS=10000
# Absolute path to the claude binary used for wake-on-event headless runs.
HIVE_CLAUDE_BIN=claude
# Set to 0 to make this machine listen and chat but never auto-spawn a session.
HIVE_WAKE_ENABLED=1
HIVE_WAKE_CWD=
